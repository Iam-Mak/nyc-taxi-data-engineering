{
	"name": "ds_http_yellow_taxi_binary",
	"properties": {
		"description": "References the public NYC TLC Yellow Taxi Parquet files through an HTTP linked service, using parameterised year and month values to dynamically construct the source file URL for monthly ingestion.",
		"linkedServiceName": {
			"referenceName": "ls_http_nyc_tlc",
			"type": "LinkedServiceReference"
		},
		"parameters": {
			"p_year": {
				"type": "string",
				"defaultValue": "2025"
			},
			"p_month": {
				"type": "string",
				"defaultValue": "01"
			}
		},
		"annotations": [],
		"type": "Binary",
		"typeProperties": {
			"location": {
				"type": "HttpServerLocation",
				"relativeUrl": {
					"value": "@concat(\n    '/trip-data/yellow_tripdata_',\n    dataset().p_year,\n    '-',\n    dataset().p_month,\n    '.parquet'\n)",
					"type": "Expression"
				}
			}
		}
	}
}